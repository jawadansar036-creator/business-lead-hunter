# Paste your n8n PRODUCTION webhook URL here.
# Keep this value server-side. Never add it to NEXT_PUBLIC_ variables.
N8N_WEBHOOK_URL=https://YOUR-N8N-HOST/webhook/YOUR-WEBHOOK-PATH

# Optional: shared secret sent to n8n in the x-lead-hunter-token header.
# Configure the same secret check in your n8n workflow before enabling this.
N8N_SHARED_SECRET=
